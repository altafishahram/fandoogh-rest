{
  "version": "0.4",
  "title": "TastyMenu - Fine Dining & Cafe Kit",
  "type": "page",
  "content": [
    {
      "id": "sec-fine-dining-1",
      "elType": "section",
      "elements": [
        {
          "id": "col-fine-dining-1",
          "elType": "column",
          "elements": [
            {
              "id": "w-branch-fd",
              "elType": "widget",
              "widgetType": "rmm_branch_selector",
              "settings": {
                "show_status": "yes",
                "show_table": "yes",
                "show_lang": "yes"
              }
            },
            {
              "id": "w-cat-fd",
              "elType": "widget",
              "widgetType": "rmm_category_bar",
              "settings": {
                "is_sticky": "yes",
                "show_all_button": "yes"
              }
            },
            {
              "id": "w-menu-fd",
              "elType": "widget",
              "widgetType": "rmm_food_menu_grid",
              "settings": {
                "layout_style": "fine_dining",
                "columns": "2",
                "show_search": "yes",
                "show_badges": "yes",
                "show_calories": "no"
              }
            },
            {
              "id": "w-cart-fd",
              "elType": "widget",
              "widgetType": "rmm_floating_cart",
              "settings": {
                "cart_btn_text": "مشاهده سفارش کافه"
              }
            }
          ]
        }
      ]
    }
  ]
}
