msgstr "Project-Id-Version: Fandoogh Rest 1.4.0\nLanguage: tr_TR\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\nPlural-Forms: nplurals=2; plural=(n > 1);\n"

#: resources/customer-server-strings.json
msgid "A unique request ID is required."
msgstr "Benzersiz bir istek kimliği gerekli."

#: resources/customer-server-strings.json
msgid "All cart items and checkout must belong to the selected branch. Return to its menu or confirm replacing your cart."
msgstr "Sepetteki ürünler ve ödeme seçilen şubeye ait olmalıdır. Şubenin menüsüne dönün veya sepeti değiştirmeyi onaylayın."

#: resources/customer-server-strings.json
msgid "All items must belong to the selected branch."
msgstr "Tüm ürünler seçilen şubeye ait olmalıdır."

#: resources/customer-server-strings.json
msgid "An item is unavailable."
msgstr "Ürünlerden biri şu anda mevcut değil."

#: resources/customer-server-strings.json
msgid "An item list is required."
msgstr "Sipariş ürün listesi gerekli."

#: resources/customer-server-strings.json
msgid "Branch is unavailable."
msgstr "Bu şube kullanılamıyor."

#: resources/customer-server-strings.json
msgid "Branch not found."
msgstr "Şube bulunamadı."

#: resources/customer-server-strings.json
msgid "Choose a branch before ordering."
msgstr "Sipariş vermeden önce bir şube seçin."

#: resources/customer-server-strings.json
msgid "Choose a valid branch."
msgstr "Geçerli bir şube seçin."

#: resources/customer-server-strings.json
msgid "Choose between 1 and 100 items."
msgstr "1 ile 100 arasında ürün seçin."

#: resources/customer-server-strings.json
msgid "Choose pickup or delivery from the restaurant menu before checkout."
msgstr "Ödemeden önce restoran menüsünden gel-al veya teslimat seçin."

#: resources/customer-server-strings.json
msgid "Conflicting branch selection."
msgstr "Seçilen şube istek bilgileriyle uyuşmuyor."

#: resources/customer-server-strings.json
msgid "Cross-site order requests are not allowed."
msgstr "Başka bir siteden sipariş isteğine izin verilmiyor."

#: resources/customer-server-strings.json
msgid "Enable browser JavaScript to use the menu and panel."
msgstr "Menüyü kullanmak için tarayıcınızda JavaScript'i etkinleştirin."

#: resources/customer-server-strings.json
msgid "Invalid branch."
msgstr "Geçersiz şube."

#: resources/customer-server-strings.json
msgid "Invalid checkout channel."
msgstr "Sipariş teslim şekli geçersiz."

#: resources/customer-server-strings.json
msgid "Invalid item."
msgstr "Geçersiz sipariş kalemi."

#: resources/customer-server-strings.json
msgid "Invalid product or quantity."
msgstr "Ürün veya miktar geçersiz."

#: resources/customer-server-strings.json
msgid "Invalid table."
msgstr "Geçersiz masa."

#: resources/customer-server-strings.json
msgid "Menu"
msgstr "Menü"

#: resources/customer-server-strings.json
msgid "Order not found."
msgstr "Sipariş bulunamadı."

#: resources/customer-server-strings.json
msgid "Ordering is unavailable."
msgstr "Sipariş verme şu anda kullanılamıyor."

#: resources/customer-server-strings.json
msgid "Product not found."
msgstr "Ürün bulunamadı."

#: resources/customer-server-strings.json
msgid "Request ID already used for different items."
msgstr "Bu istek kimliği farklı bir sipariş için kullanılmış."

#: resources/customer-server-strings.json
msgid "Requested quantity is unavailable."
msgstr "İstenen miktar stokta yok."

#: resources/customer-server-strings.json
msgid "Table ordering is unavailable."
msgstr "Masadan sipariş verme şu anda kullanılamıyor."

#: resources/customer-server-strings.json
msgid "Table unavailable."
msgstr "Bu masa şu anda kullanılamıyor."

#: resources/customer-server-strings.json
msgid "The table belongs to a different branch."
msgstr "Masa başka bir şubeye ait."

#: resources/customer-server-strings.json
msgid "This branch is unavailable."
msgstr "Bu şube kullanılamıyor."

#: resources/customer-server-strings.json
msgid "This branch menu is unavailable."
msgstr "Bu şubenin menüsü kullanılamıyor."

#: resources/customer-server-strings.json
msgid "This ordering channel is unavailable."
msgstr "Bu sipariş yöntemi şu anda kullanılamıyor."

#: resources/customer-server-strings.json
msgid "This request is being processed."
msgstr "Bu istek işleniyor."

#: resources/customer-server-strings.json
msgid "This request needs staff review before retrying. Please contact the restaurant."
msgstr "Tekrar denemeden önce bu istek personel tarafından incelenmeli. Lütfen restoranla iletişime geçin."

#: resources/customer-server-strings.json
msgid "This table menu is unavailable."
msgstr "Bu masanın menüsü şu anda kullanılamıyor."

#: resources/customer-server-strings.json
msgid "This table supports menu viewing only."
msgstr "Bu masada yalnızca menü görüntülenebilir."

#: resources/customer-server-strings.json
msgid "Toman"
msgstr "Toman"

#: resources/customer-server-strings.json
msgid "Too many requests. Please wait and try again."
msgstr "Çok fazla istek gönderildi. Lütfen bekleyip tekrar deneyin."

#: resources/customer-server-strings.json
msgid "Unable to create the order. Please try again."
msgstr "Sipariş oluşturulamadı. Lütfen tekrar deneyin."

#: resources/customer-server-strings.json
msgid "Unsupported customer language."
msgstr "Seçilen dil desteklenmiyor."

#: resources/customer-server-strings.json
msgid "Your cart belongs to another branch. Confirm replacing it to continue."
msgstr "Sepetiniz başka bir şubeye ait. Devam etmek için değiştirmeyi onaylayın."

#: resources/customer-server-strings.json
msgid "Your session has expired. Reload the menu and try again."
msgstr "Oturumunuzun süresi doldu. Menüyü yenileyip tekrar deneyin."

